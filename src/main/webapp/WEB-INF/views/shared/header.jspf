<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-token" content="<c:out value='${csrfToken}'/>">
    <meta name="app-context" content="<c:out value='${pageContext.request.contextPath}'/>">
    <link rel="stylesheet" href="<c:url value='/assets/site.css'/>">
    <script defer src="<c:url value='/assets/site.js'/>"></script>
    <title>竞序 · 校内竞赛管理平台</title>
</head>
<body>
<c:choose>
    <c:when test="${not empty area}">
        <div class="app-shell">
            <aside class="sidebar">
                <a class="brand" href="<c:url value='/'/>"><i class="brand-mark"></i>竞序</a>
                <nav aria-label="工作区">
                    <c:choose>
                        <c:when test="${area eq 'student'}">
                            <a href="<c:url value='/student'/>">我的报名</a>
                            <a href="<c:url value='/student#invitations'/>">组队邀请</a>
                            <a href="<c:url value='/student/profile'/>">个人资料</a>
                        </c:when>
                        <c:when test="${area eq 'judge'}">
                            <a href="<c:url value='/judge'/>">我的评审</a>
                            <c:if test="${actor.managesEvents()}"><a href="<c:url value='/admin'/>">赛事管理</a></c:if>
                        </c:when>
                        <c:otherwise>
                            <a href="<c:url value='/admin'/>">赛事管理</a>
                            <c:if test="${actor.has('JUDGE')}"><a href="<c:url value='/judge'/>">我的评审</a></c:if>
                            <c:if test="${actor.has('ADMIN')}">
                                <a href="<c:url value='/admin/accounts'/>">账户与核验</a>
                                <a href="<c:url value='/admin/audit'/>">操作审计</a>
                            </c:if>
                        </c:otherwise>
                    </c:choose>
                    <a href="<c:url value='/'/>">公开赛事大厅</a>
                </nav>
                <form data-api="/auth/logout" data-next="/"><button class="button light">退出登录</button></form>
            </aside>
            <main class="workspace" id="main">
    </c:when>
    <c:otherwise>
        <header class="topbar">
            <div class="public-wrap between">
                <a class="brand" href="<c:url value='/'/>"><i class="brand-mark"></i>竞序</a>
                <nav class="public-nav" aria-label="主导航">
                    <a href="<c:url value='/'/>">赛事大厅</a>
                    <a href="<c:url value='/announcements'/>">获奖公告</a>
                </nav>
                <c:choose>
                    <c:when test="${not empty actor}">
                        <c:url var="homeLink" value="${actor.home()}"/>
                        <a class="button" href="${homeLink}">我的工作台</a>
                    </c:when>
                    <c:otherwise>
                        <div class="actions"><a href="<c:url value='/login'/>">登录</a><a class="button" href="<c:url value='/register'/>">注册</a></div>
                    </c:otherwise>
                </c:choose>
            </div>
        </header>
        <main class="public-wrap" id="main">
    </c:otherwise>
</c:choose>
<div id="notice" class="notice global-notice" role="status" hidden></div>
